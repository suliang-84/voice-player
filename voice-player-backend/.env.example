# 复制为 .env 后按需修改
HOST=0.0.0.0
PORT=10090
DATA_DIR=data
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   # 为空时用 DATA_DIR 下的 SQLite
CORS_ORIGINS=*

# 鉴权：token 由业务系统用同一密钥签发（HS256，sub=用户ID，typ=access）
AUTH_ENABLED=false
JWT_SECRET=change-me

# 转写（需 pip install -r requirements-asr.txt）；none 表示不启用
ASR_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# 首次使用需下载模型；转写任务最多等待模型就绪的秒数，超时则任务失败并提示，就绪后自动重试
ASR_LOAD_TIMEOUT=120
# 模型加载失败后，多少秒后才在下次访问时重新加载
ASR_RETRY_INTERVAL=60

# 大模型（OpenAI 兼容）：身份推断 / 场景分析 / 翻译；不配置则退回 unknown / 空
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DEFAULT_TRANSLATION_LANGUAGE=en
