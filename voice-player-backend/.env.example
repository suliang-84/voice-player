# 复制为 .env 后按需修改
HOST=0.0.0.0
PORT=10090
DATA_DIR=data
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   # 为空时用 DATA_DIR 下的 SQLite
CORS_ORIGINS=*

# 音频入口：生产环境由入库系统调用 POST /api/v1/audios/{audioId}/ingest 提交（按地址拉取）
# 允许拉取的主机，逗号分隔（可带端口，如 storage.internal:9000）；为空则不接受任何地址
INGEST_ALLOWED_HOSTS=
INGEST_TIMEOUT=120
# 上传接口只用于开发测试，生产环境关闭
UPLOAD_ENABLED=true

# 鉴权：token 由业务系统用同一密钥签发（HS256，sub=用户ID，typ=access）
AUTH_ENABLED=false
JWT_SECRET=change-me

# 转写引擎：mock（默认，内置演示数据，不加载模型）| faster-whisper（需 pip install -r requirements-asr.txt）| none（不启用）
ASR_PROVIDER=mock
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# 首次使用需下载模型；转写任务最多等待模型就绪的秒数，超时则任务失败并提示，就绪后自动重试
ASR_LOAD_TIMEOUT=120
# 模型加载失败后，多少秒后才在下次访问时重新加载
ASR_RETRY_INTERVAL=60

# 大模型（OpenAI 兼容）：身份推断 / 场景分析 / 翻译。LLM_PROVIDER=mock（默认）使用内置的演示数据；
# 对接真实大模型时清空 LLM_PROVIDER，并填写下面三项；都不配置则退回 unknown / 空
LLM_PROVIDER=mock
# 仅 mock 引擎使用：每个声道模拟的转写耗时（秒），用来演示转写进度
MOCK_DELAY=3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DEFAULT_TRANSLATION_LANGUAGE=en
